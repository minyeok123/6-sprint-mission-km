// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  name                  String
  nickname              String                 @unique
  password              String
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  profileImage          ProfileImage?
  userPreference        UserPreference?
  order                 Order[]
  products              Product[]
  articles              Article[]
  articleLikes          ArticleLike[]
  productLikes          ProductLike[]
  articleComment        ArticleComment[]
  productComment        ProductComment[]
  productInquiries      ProductInquiry[]
  productInquiryAnswers ProductInquiryAnswer[]
  notifications         Notification[]

  @@map("users")
}

model UserPreference {
  id            Int      @id @default(autoincrement())
  receivedEmail Boolean  @default(false) @map("received_email")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int      @unique @map("user_id")

  @@map("user_preferences")
}

model ProfileImage {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @unique @map("user_id")

  @@map("profile_images")
}

model Order {
  id         Int         @id @default(autoincrement())
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  unitPrice Float    @map("unit_price")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int      @map("order_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")

  @@map("order_items")
}

model Product {
  id               Int              @id @default(autoincrement())
  productName      String           @map("product_name")
  description      String
  price            Float
  stock            Int
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int              @map("user_id")
  orderItem        OrderItem[]
  productImages    ProductImage[]
  productLikes     ProductLike[]
  productComments  ProductComment[]
  productTags      ProductWithTag[]
  productInquiries ProductInquiry[]
  notifications    Notification[]

  @@map("products")
}

model Tag {
  id          Int              @id @default(autoincrement())
  tag         String
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  productTags ProductWithTag[]

  @@map("tags")
}

model ProductWithTag {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  tagId     Int      @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@map("product_with_tags")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")

  @@map("product_images")
}

model ProductInquiry {
  id                    Int                   @id @default(autoincrement())
  userId                Int                   @map("user_id")
  productId             Int                   @map("product_id")
  content               String
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  product               Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  productInquiryAnswers ProductInquiryAnswer?

  @@map("product_inquiries")
}

model ProductInquiryAnswer {
  id               Int            @id @default(autoincrement())
  userId           Int            @map("user_id")
  productInquiryId Int            @unique @map("product_inquiry_id")
  content          String
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productInquiry   ProductInquiry @relation(fields: [productInquiryId], references: [id], onDelete: Cascade)

  @@map("product_inquiry_answers")
}

model Article {
  id              Int              @id @default(autoincrement())
  title           String
  content         String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int              @map("user_id")
  articleImages   ArticleImage[]
  articleLikes    ArticleLike[]
  articleComments ArticleComment[]
  notifications   Notification[]

  @@map("articles")
}

model ArticleImage {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int      @map("article_id")

  @@map("article_images")
}

model ArticleLike {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  articleId Int      @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("article_likes")
}

model ProductLike {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_likes")
}

model ArticleComment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  articleId Int      @map("article_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("article_comments")
}

model ProductComment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("product_comments")
}

enum OrderStatus {
  PENDING
  COMPLETE
}

model Notification {
  id      Int              @id @default(autoincrement())
  userId  Int              @map("user_id")
  message String
  isRead  Boolean          @default(false) @map("is_read")
  type    NotificationType

  productId Int? @map("product_id")
  articleId Int? @map("article_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  PRICE_CHANGE
  NEW_COMMENT
}
